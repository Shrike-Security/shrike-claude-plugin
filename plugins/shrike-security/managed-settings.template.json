{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|SubagentHandback|Bash|Write|Edit|NotebookEdit|WebSearch|WebFetch|mcp__.*|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/lib/shrike-hook/shrike-pretooluse.sh\"",
            "timeout": 40,
            "statusMessage": "Shrike is scanning this action…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|SubagentHandback|Bash|Write|Edit|NotebookEdit|WebSearch|WebFetch|mcp__.*|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/lib/shrike-hook/shrike-pretooluse.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|SubagentHandback|Bash|Write|Edit|NotebookEdit|WebSearch|WebFetch|mcp__.*|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/lib/shrike-hook/shrike-pretooluse.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/lib/shrike-hook/shrike-pretooluse.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/lib/shrike-hook/shrike-pretooluse.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/lib/shrike-hook/shrike-pretooluse.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/lib/shrike-hook/shrike-pretooluse.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/lib/shrike-hook/shrike-pretooluse.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/lib/shrike-hook/shrike-pretooluse.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "SHRIKE_API_KEY": "REPLACE_WITH_THE_ORG_API_KEY",
    "SHRIKE_FAILURE_MODE": "closed"
  }
}
